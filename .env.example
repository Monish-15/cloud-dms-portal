# Secure Document Management Portal - Environment Configuration Template
# Duplicate this file to .env for local overrides. NEVER commit production secrets!

# Flask Core
FLASK_ENV=development
SECRET_KEY=dev-change-in-production-use-strong-random-key-64chars
PORT=5000

# Storage Selection ('local' or 'azure')
STORAGE_BACKEND=local
LOCAL_UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=10485760

# Production Azure Storage (Required when STORAGE_BACKEND=azure)
AZURE_STORAGE_ACCOUNT_NAME=stdocmgmtportalprod
AZURE_STORAGE_CONTAINER_NAME=secure-docs
AZURE_USE_MANAGED_IDENTITY=true
# Connection string is ONLY needed for local development against live Azure Storage without Managed Identity
AZURE_STORAGE_CONNECTION_STRING=

# Database URI (SQLite default for dev; Azure SQL / PostgreSQL / SQLite for App Service)
DATABASE_URL=sqlite:///dev_portal.db

# Seed Admin Credentials (used by 'flask seed-admin')
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@portal.local
INITIAL_ADMIN_PASSWORD=AdminPass123!
