# Example variables file - copy to terraform.tfvars and fill in your values
location        = "eastus"
resource_prefix = "docdms"
environment     = "prod"
app_service_sku = "B1" # B1 basic tier or F1 free tier
container_name  = "secure-docs"
secret_key      = "generate-a-strong-secret-key-at-least-32-chars-long"

tags = {
  Project     = "SecureDocumentPortal"
  ManagedBy   = "Terraform"
  Owner       = "StudentAdmin"
  Environment = "Production"
}
